---
const year = new Date().getFullYear();
---

<footer style="border-top: 1px solid var(--border); margin-top: 6rem;">
  <div style="max-width: 720px; margin: 0 auto; padding: 2rem 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
    <span style="font-size: 0.875rem; color: var(--text-muted);">
      © {year} André Fragata
    </span>
    <div style="display: flex; gap: 1.25rem; align-items: center;">
      <a href="https://github.com/OwLinxs" target="_blank" rel="noopener noreferrer" style="font-size: 0.875rem; color: var(--text-muted); transition: color 0.15s ease;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-muted)'">GitHub</a>
      <a href="https://linkedin.com/in/andrefragata" target="_blank" rel="noopener noreferrer" style="font-size: 0.875rem; color: var(--text-muted); transition: color 0.15s ease;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-muted)'">LinkedIn</a>
      <a href="mailto:andrefragata14@gmail.com" style="font-size: 0.875rem; color: var(--text-muted); transition: color 0.15s ease;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-muted)'">Email</a>
    </div>
  </div>
</footer>
