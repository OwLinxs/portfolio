---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Blog — André Fragata" description="Textos sobre infraestrutura, segurança, automação e aprendizado.">
  <Header />

  <main style="max-width: 720px; margin: 0 auto; padding: 0 1.5rem;">
    <section style="padding: 4rem 0;">
      <h1 style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; color: var(--text); margin-bottom: 0.75rem;">
        Blog
      </h1>
      <p style="font-size: 1rem; color: var(--text-muted); margin-bottom: 3rem; line-height: 1.6;">
        Ideias, descobertas e coisas que aprendi no caminho.
      </p>

      {posts.length === 0 ? (
        <p style="color: var(--text-muted); font-size: 0.9375rem;">
          Nenhum post ainda. Em breve.
        </p>
      ) : (
        <div style="display: flex; flex-direction: column;">
          {posts.map((post, i) => (
            <a
              href={`/blog/${post.id}`}
              style={`
                display: block;
                padding: 1.5rem 0;
                ${i < posts.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}
                transition: opacity 0.15s ease;
              `}
              onmouseover="this.style.opacity='0.75'"
              onmouseout="this.style.opacity='1'"
            >
              <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem;">
                <h2 style="font-size: 1rem; font-weight: 600; color: var(--text); line-height: 1.4;">
                  {post.data.title}
                </h2>
                <time
                  datetime={post.data.date.toISOString()}
                  style="font-size: 0.8125rem; color: var(--text-muted); flex-shrink: 0; font-family: var(--font-mono);"
                >
                  {post.data.date.toLocaleDateString('pt-BR', { year: 'numeric', month: 'short' })}
                </time>
              </div>
              <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 0.75rem;">
                {post.data.description}
              </p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div style="display: flex; gap: 0.375rem; flex-wrap: wrap;">
                  {post.data.tags.map(tag => (
                    <span style="font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 4px; border: 1px solid var(--border); color: var(--text-muted);">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      )}
    </section>
  </main>

  <Footer />
</Layout>
