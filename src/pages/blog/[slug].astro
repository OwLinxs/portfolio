---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — André Fragata`} description={post.data.description}>
  <Header />

  <main style="max-width: 720px; margin: 0 auto; padding: 0 1.5rem;">
    <article style="padding: 4rem 0;">

      <!-- Back link -->
      <a
        href="/blog"
        style="
          display: inline-flex;
          align-items: center;
          gap: 0.375rem;
          font-size: 0.875rem;
          color: var(--text-muted);
          margin-bottom: 2.5rem;
          transition: color 0.15s ease;
        "
        onmouseover="this.style.color='var(--text)'"
        onmouseout="this.style.color='var(--text-muted)'"
      >
        ← Blog
      </a>

      <!-- Header -->
      <header style="margin-bottom: 3rem;">
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem;">
          {post.data.tags && post.data.tags.map(tag => (
            <span style="font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid var(--border); color: var(--accent);">
              {tag}
            </span>
          ))}
        </div>
        <h1 style="font-size: clamp(1.5rem, 4vw, 2.25rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.2; color: var(--text); margin-bottom: 1rem;">
          {post.data.title}
        </h1>
        <p style="font-size: 1rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1.25rem;">
          {post.data.description}
        </p>
        <div style="display: flex; align-items: center; gap: 1rem;">
          <time
            datetime={post.data.date.toISOString()}
            style="font-size: 0.875rem; color: var(--text-muted); font-family: var(--font-mono);"
          >
            {post.data.date.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
        <hr style="border: none; border-top: 1px solid var(--border); margin-top: 1.5rem;" />
      </header>

      <!-- Content -->
      <div class="prose">
        <Content />
      </div>

    </article>
  </main>

  <Footer />
</Layout>
