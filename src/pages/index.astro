---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featured = projects.filter(p => p.featured).slice(0, 3);
---

<Layout title="André Fragata">
  <Header />

  <main style="max-width: 720px; margin: 0 auto; padding: 0 1.5rem;">

    <!-- Hero -->
    <section style="padding: 5rem 0 4rem;">
      <p style="font-size: 0.875rem; color: var(--accent); font-weight: 500; margin-bottom: 1rem; letter-spacing: 0.05em; text-transform: uppercase;">
        Olá, eu sou
      </p>
      <h1 style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; color: var(--text); margin-bottom: 1.5rem;">
        André Fragata
      </h1>
      <p style="font-size: 1.125rem; color: var(--text-muted); line-height: 1.7; max-width: 520px; margin-bottom: 2rem;">
        Trabalho com infraestrutura e segurança em Francisco Beltrão, PR.
        Gosto de automatizar coisas, explorar sistemas e documentar o que aprendo.
      </p>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a
          href="/projects"
          style="
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.625rem 1.25rem;
            background: var(--accent);
            color: white;
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 500;
            transition: opacity 0.15s ease;
          "
          onmouseover="this.style.opacity='0.85'"
          onmouseout="this.style.opacity='1'"
        >
          Ver projetos
        </a>
        <a
          href="/about"
          style="
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.625rem 1.25rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text);
            transition: all 0.15s ease;
          "
          onmouseover="this.style.backgroundColor='var(--bg-surface)'"
          onmouseout="this.style.backgroundColor='transparent'"
        >
          Sobre mim
        </a>
      </div>
    </section>

    <!-- Featured Projects -->
    <section style="padding-bottom: 4rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <h2 style="font-size: 1rem; font-weight: 600; color: var(--text);">Projetos em destaque</h2>
        <a href="/projects" style="font-size: 0.875rem; color: var(--accent); transition: opacity 0.15s ease;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
          ver todos →
        </a>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1px; border: 1px solid var(--border); border-radius: 10px; overflow: hidden;">
        {featured.map((project, i) => (
          <div
            style={`
              padding: 1.25rem 1.5rem;
              background: var(--bg-surface);
              transition: background 0.15s ease;
              ${i < featured.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}
            `}
            onmouseover="this.style.background='var(--bg)'"
            onmouseout="this.style.background='var(--bg-surface)'"
          >
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
              <div style="flex: 1; min-width: 0;">
                <h3 style="font-size: 0.9375rem; font-weight: 600; color: var(--text); margin-bottom: 0.375rem;">
                  {project.title}
                </h3>
                <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 0.75rem;">
                  {project.description}
                </p>
                <div style="display: flex; gap: 0.375rem; flex-wrap: wrap;">
                  {project.tags.map(tag => (
                    <span style="font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid var(--border); color: var(--text-muted); font-family: var(--font-mono);">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              {project.links.github && (
                <a
                  href={project.links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="flex-shrink: 0; color: var(--text-muted); transition: color 0.15s ease;"
                  onmouseover="this.style.color='var(--text)'"
                  onmouseout="this.style.color='var(--text-muted)'"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                  </svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Recent Posts -->
    {posts.length > 0 && (
      <section style="padding-bottom: 4rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
          <h2 style="font-size: 1rem; font-weight: 600; color: var(--text);">Posts recentes</h2>
          <a href="/blog" style="font-size: 0.875rem; color: var(--accent); transition: opacity 0.15s ease;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
            ver todos →
          </a>
        </div>

        <div style="display: flex; flex-direction: column; gap: 2rem;">
          {posts.map(post => (
            <a
              href={`/blog/${post.id}`}
              style="display: block; group;"
              onmouseover="this.querySelector('span').style.color='var(--accent)'"
              onmouseout="this.querySelector('span').style.color='var(--text)'"
            >
              <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.375rem;">
                <span style="font-size: 0.9375rem; font-weight: 500; color: var(--text); transition: color 0.15s ease;">
                  {post.data.title}
                </span>
                <time style="font-size: 0.8125rem; color: var(--text-muted); flex-shrink: 0; font-family: var(--font-mono);">
                  {post.data.date.toLocaleDateString('pt-BR', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.6;">
                {post.data.description}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

  </main>

  <Footer />
</Layout>
